---
const { title, description, currentSlug } = Astro.props
const fullTitle = title ? `${title} · Peisistratus` : 'Peisistratus'

const nav = [
  { label: 'The Dawn', href: '/1-Dawn/The-Dawn', prefix: '1-Dawn/' },
  { label: 'Bedrock', href: '/2-Bedrock/Bedrock', prefix: '2-Bedrock/' },
  { label: 'Callings', href: '/3-Callings/Callings', prefix: '3-Callings/' },
  { label: 'Enchantments', href: '/4-Enchantments/Enchantments', prefix: '4-Enchantments/' },
  { label: 'Legacies', href: '/5-Legacies/Legacies', prefix: '5-Legacies/' },
  { label: 'Coda', href: '/6-Coda/Coda-and-Caliphon', prefix: '6-Coda/' },
]

const isActive = (prefix) => (currentSlug ? String(currentSlug).startsWith(prefix) : false)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description ? <meta name="description" content={description} /> : null}
    <meta name="color-scheme" content="light dark" />
    <link rel="stylesheet" href="/styles/theme.css" />
  </head>
  <body>
    <header class="siteHeader">
      <div class="container bar">
        <a class="brand" href="/">
          Peisistratus
          <small>Path</small>
        </a>
        <nav class="nav">
          <a href="/">Home</a>
          <a href="/search">Search</a>
          <a href="https://x.com/peisistratus" rel="me">X</a>
        </nav>
      </div>
    </header>

    <main class="container shell">
      <aside class="panel sidebar">
        <div class="sideTitle">Acts</div>
        <nav class="sideNav">
          {nav.map((item) => (
            <a href={item.href} data-active={isActive(item.prefix) ? 'true' : 'false'}>
              <span>{item.label}</span>
              <span class="meta">→</span>
            </a>
          ))}
        </nav>
      </aside>

      <section class="panel main">
        <slot />
      </section>
    </main>

    <footer class="footer">
      <div class="container">
        <div>© {new Date().getFullYear()} Peisistratus</div>
        <div style="display:flex; gap:12px;">
          <a href="/">Home</a>
          <a href="/search">Search</a>
          <a href="https://x.com/peisistratus">X</a>
        </div>
      </div>
    </footer>
  </body>
</html>
