---
import Layout from '../layouts/Layout.astro'

const modules = import.meta.glob('../content/notes/**/*.md', { eager: true })

function toSlug(path) {
  return path
    .replace(/^\.\.\/content\/notes\//, '')
    .replace(/\.md$/, '')
}

const slugs = Object.keys(modules).map(toSlug).sort((a, b) => a.localeCompare(b))

const byTop = new Map()
for (const s of slugs) {
  const top = s.split('/')[0]
  const arr = byTop.get(top) ?? []
  arr.push(s)
  byTop.set(top, arr)
}
---

<Layout title={"Path"} description={"A living manual of the Path."} currentSlug={""}>
  <section class="hero">
    <div class="prose">
      <h1>Path</h1>
      <p class="lede">
        A living manual. Reader-first navigation with a light mythic tone.
      </p>

      <div class="cta">
        <a class="btn primary" href="/1-Dawn/The-Dawn">Start here</a>
        <a class="btn" href="#contents">Browse contents</a>
      </div>
    </div>
  </section>

  <section id="contents" class="contents">
    <h2>Contents</h2>

    <div class="groups">
      {[...byTop.entries()].sort(([a], [b]) => a.localeCompare(b)).map(([top, arr]) => (
        <div class="group">
          <h3>{top}</h3>
          <ul>
            {arr.slice(0, 40).map((slug) => (
              <li><a href={'/' + slug}>{slug.split('/').slice(1).join('/') || slug}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <style>
    .lede { margin-top: 8px; }
    .cta { display:flex; gap: 10px; margin: 14px 0 0; flex-wrap: wrap; }

    .contents { margin-top: 18px; }
    .groups { display:grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
    @media (max-width: 980px) { .groups { grid-template-columns: 1fr; } }
    .group h3 { margin: 0 0 8px; font-family: var(--font-serif); }
    .group ul { margin: 0; padding-left: 16px; }
  </style>
</Layout>
