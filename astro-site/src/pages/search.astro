---
import Layout from '../layouts/Layout.astro'
---

<Layout title="Search" description="Search the Path.">
  <section class="prose" data-pagefind-body>
    <h1>Search</h1>
    <div id="search" class="search"></div>
    <script type="module">
      // Pagefind UI via CDN (simple + works on GH Pages)
      import { PagefindUI } from "https://unpkg.com/@pagefind/default-ui@1.2.0/pagefind-ui.js";
      new PagefindUI({
        element: "#search",
        showImages: false,
        translations: { placeholder: "Search the Path…" },
      });
    </script>
    <link rel="stylesheet" href="https://unpkg.com/@pagefind/default-ui@1.2.0/pagefind-ui.css" />

    <style>
      .search { margin-top: 10px; }
    </style>
  </section>
</Layout>
